# Optional model gateway. Leave empty to use the built-in local deterministic generator.
SPARKPLAY_LLM_BASE_URL=https://api.openai.com/v1
SPARKPLAY_LLM_MODEL=gpt-5.5
SPARKPLAY_LLM_REASONING_EFFORT=medium
SPARKPLAY_LLM_TIMEOUT_MS=120000
SPARKPLAY_LLM_MAX_OUTPUT_TOKENS=12000
SPARKPLAY_LLM_API_KEY=replace-with-your-api-key

# Local development only: read base_url/model/token from ~/.codex/config.toml.
# Do not use this mode in production.
# SPARKPLAY_LLM_CONFIG_SOURCE=codex
# SPARKPLAY_CODEX_CONFIG_PATH=/Users/shaguo/.codex/config.toml

# Optional database. Leave empty to keep using the local JSON adapter in development.
# Use a local or hosted Postgres connection string when running Prisma commands.
DATABASE_URL=postgresql://user:password@localhost:5432/sparkplay?schema=public

# Runtime adapter selector. Use postgres only after DATABASE_URL and schema are ready.
SPARKPLAY_DATA_ADAPTER=local-json

# Optional queue. Leave as in-process for local development without Redis.
SPARKPLAY_QUEUE_ADAPTER=in-process
REDIS_URL=redis://localhost:6379
SPARKPLAY_WORKER_CONCURRENCY=2

# Optional browser smoke test. Install Chromium with `npm run smoke:install` before enabling.
SPARKPLAY_SMOKE_ENABLED=false

# Optional GitHub OAuth login. Required when enabling real account login.
SPARKPLAY_PUBLIC_APP_URL=http://localhost:3000
SPARKPLAY_AUTH_SECRET=replace-with-a-long-random-string
SPARKPLAY_GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
SPARKPLAY_GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
